<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sqx.modules.app.dao.UserVipDao">

    <resultMap id="BaseResultMap" type="com.sqx.modules.app.entity.UserVip">
            <id property="vipId" column="vip_id" jdbcType="BIGINT"/>
            <result property="vipNameType" column="vip_name_type" jdbcType="INTEGER"/>
            <result property="userId" column="user_id" jdbcType="BIGINT"/>
            <result property="createTime" column="create_time" jdbcType="VARCHAR"/>
            <result property="endTime" column="end_time" jdbcType="VARCHAR"/>
            <result property="isVip" column="is_vip" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        vip_id,vip_name_type,user_id,
        create_time,end_time,is_vip
    </sql>
    <select id="selectByUserId" resultType="com.sqx.modules.app.entity.UserVip">
        select
        <include refid="Base_Column_List"/>
        from user_vip
        where user_id = #{userId} and is_vip = 1 and end_time > CURRENT_TIMESTAMP
    </select>
</mapper>
