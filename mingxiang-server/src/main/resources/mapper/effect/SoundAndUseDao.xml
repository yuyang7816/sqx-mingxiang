<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sqx.modules.effect.dao.SoundAndUserDao">

    <resultMap id="BaseResultMap" type="com.sqx.modules.effect.entity.SoundAndUser">
            <id property="id" column="id" jdbcType="INTEGER"/>
            <result property="userId" column="user_id" jdbcType="INTEGER"/>
            <result property="effectsId" column="effects_id" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,user_id,effects_id
    </sql>
    <insert id="insertBatch">
        insert into  sound_and_user (user_id,effects_id) values
        <foreach collection="list" item="item" separator=",">
            (#{item.userId},#{item.effectsId})
        </foreach>
    </insert>
    <select id="selectCountByUserId" resultType="java.lang.Integer">
        select count(1) from sound_and_user
        where id = #{id}
        and user_id = #{userId}
    </select>
</mapper>
